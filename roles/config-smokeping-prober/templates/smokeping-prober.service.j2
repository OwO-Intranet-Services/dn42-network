# Generated by Ansible
[Unit]
Description=Smokeping Prober
After=network.target

[Service]
ExecStart={{ smokeping_prober_binary_path }} \
    --config.file={{ smokeping_prober_config_file }} \
    --web.listen-address={{ smokeping_prober_listen }} \
    --buckets={{ smokeping_prober_buckets }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
