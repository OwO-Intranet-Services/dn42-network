# Generated by Ansible
targets:
{% for host in groups[dn42_group] %}
{% if host != inventory_hostname %}
  - hosts:
      - {{ hostvars[host].ownip6 }}
    interval: {{ smokeping_prober_ping_interval }}
    network: ip6
    protocol: icmp
    labels:
      target: {{ host }}
{% endif %}
{% endfor %}
