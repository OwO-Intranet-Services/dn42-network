{%- set peer_name = dn42_prefix + (item.bgp.asn | string)[-4:] -%}
{%- set extended_next_hop_switch = 'on' if item.bgp.get('extended_next_hop') else 'off' -%}
{%- set latency = (dn42_peer_latency_map.get(peer_name, dn42_latency_community_default) | trim) -%}
{%- set bandwidth = (item.bgp.get('community', {}).get('bandwidth', dn42_bandwidth_community_default)) -%}
{%- set encryption = item.bgp.get('community', {}).get('encryption', 34) -%}
# /etc/bird/peers/{{ peer_name }}.conf
# Generated by Ansible

{% if item.bgp.get('mp_bgp') %}
protocol bgp {{ peer_name }} from dnpeers {
    enable extended messages on;
    neighbor {{ item.wg.peer6 }} as {{ item.bgp.asn }};
    interface "{{ peer_name }}";
{%   if item.bgp.get('ipv4', true) %}
    ipv4 {
        extended next hop {{ extended_next_hop_switch }};
        import where dn42_import_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
        export where dn42_export_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
    };
{%   endif %}
{%   if item.bgp.get('ipv6', true) %}
    ipv6 {
        import where dn42_import_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
        export where dn42_export_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
    };
{%   endif %}
}
{% else %}

{# Non-MP-BGP configuration #}

{%   if item.bgp.get('ipv4') %}
protocol bgp {{ peer_name }}_v4 from dnpeers {
    enable extended messages on;
    neighbor {{ item.wg.peer4 }} as {{ item.bgp.asn }};
    interface "{{ peer_name }}";
    ipv4 {
        import where dn42_import_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
        export where dn42_export_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
    };
}
{%   endif %}

{%   if item.bgp.get('ipv6') %}
protocol bgp {{ peer_name }}_v6 from dnpeers {
    enable extended messages on;
    neighbor {{ item.wg.peer6 }} as {{ item.bgp.asn }};
    interface "{{ peer_name }}";
    ipv6 {
        import where dn42_import_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
        export where dn42_export_filter({{ latency }}, {{ bandwidth }}, {{ encryption }});
    };
}
{%   endif %}
{% endif %}
