{%- set peer_name = dn42_prefix + (item.bgp.asn | string)[-4:] -%}
{%- set sessions = item | dn42_bird_sessions -%}
{%- set latency = (dn42_peer_latency_map.get(peer_name, dn42_latency_community_default) | trim) -%}
{%- set bandwidth = (item.bgp.get('community', {}).get('bandwidth', dn42_bandwidth_community_default)) -%}
{%- set encryption = item.bgp.get('community', {}).get('encryption', 34) -%}
{%- set peering_strategy = item.bgp.get('peering_strategy', 'full_table') -%}
{%- set peering_strategy_constant = {
  'full_table': 'DN42_PEERING_STRATEGY_FULL_TABLE',
  'transit': 'DN42_PEERING_STRATEGY_TRANSIT',
  'peer': 'DN42_PEERING_STRATEGY_PEER',
  'downstream': 'DN42_PEERING_STRATEGY_DOWNSTREAM'
}[peering_strategy] -%}
# /etc/bird/peers/{{ peer_name }}.conf
# Generated by Ansible
# peering_strategy = {{ peering_strategy }}
{% for session in sessions %}
protocol bgp {{ peer_name }}{{ session.name_suffix }} from dnpeers {
    enable extended messages on;
    neighbor {{ session.neighbor }} as {{ item.bgp.asn }};
    interface "{{ peer_name }}";
{%   for family in session.families %}
    {{ family.name }} {
{%     if family.extended_next_hop is not none %}
        extended next hop {{ 'on' if family.extended_next_hop else 'off' }};
{%     endif %}
        import where dn42_import_filter({{ latency }}, {{ bandwidth }}, {{ encryption }}, {{ peering_strategy_constant }});
        export where dn42_export_filter({{ latency }}, {{ bandwidth }}, {{ encryption }}, {{ peering_strategy_constant }});
    };
{%   endfor %}
}
{% endfor %}
