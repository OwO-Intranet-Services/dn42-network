# /etc/bird/dn42_grc.conf
# Generated by Ansible

{% if inventory_hostname in (bird_dn42_grc_enabled | default([])) %}
protocol bgp route_collector
{
  local as OWNAS;
  neighbor fd42:d42:d42:179::1 as 4242422602;

  advertise hostname on;
  multihop;

  ipv4 {
    add paths tx;

    import none;
    export filter {
      if ( is_valid_network() && source ~ [ RTS_STATIC, RTS_BGP ] )
      then {
        accept;
      }
      reject;
    };
  };

  ipv6 {
    add paths tx;

    import none;
    export filter {
      if ( is_valid_network_v6() && source ~ [ RTS_STATIC, RTS_BGP ] )
      then {
        if is_self_net_v6() && net != OWNNETv6 then reject;
        accept;
      }
      reject;
    };
  };
}
{% else %}
# Global route collector not enabled on this node
{% endif %}