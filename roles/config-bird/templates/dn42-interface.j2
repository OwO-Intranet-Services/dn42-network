# Generated by Ansible

auto dn42-dummy
iface dn42-dummy inet static
    pre-up ip link add dn42-dummy type dummy || true
    address {{ ownip }}
    netmask 255.255.255.255
{% if inventory_hostname in groups.get('anycast', []) %}
    # Anycast Nameservers (IPv4)
{%   for ns in dns_nameservers %}
    up ip addr add {{ ns.ipv4 }}/32 dev dn42-dummy label dn42-dummy:{{ ns.name }} || true
    down ip addr del {{ ns.ipv4 }}/32 dev dn42-dummy label dn42-dummy:{{ ns.name }} || true
{%   endfor %}
{% endif %}

iface dn42-dummy inet6 static
    address {{ ownip6 }}
    netmask 128
{% if inventory_hostname in groups.get('anycast', []) %}
    # Anycast Nameservers (IPv6)
{%   for ns in dns_nameservers %}
    up ip -6 addr add {{ ns.ipv6 }}/128 dev dn42-dummy || true
    down ip -6 addr del {{ ns.ipv6 }}/128 dev dn42-dummy || true
{%   endfor %}
{% endif %}
