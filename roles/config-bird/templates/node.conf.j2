# /etc/bird/node.conf
# Generated by Ansible
{% set announced_prefixes4 = [ownnet4] + (ownnet4_extra | default([])) %}
{% set announced_prefixes6 = [ownnet6] + (ownnet6_extra | default([])) %}

define OWNAS = {{ asn }};
define OWNIP = {{ ownip }};
define OWNIPv6 = {{ ownip6 }};
define OWNNET = {{ ownnet4 }};
define OWNNETv6 = {{ ownnet6 }};
define OWNNODENET = {{ ownip }}/32;
define OWNNODENETv6 = {{ ownip6block }};
define OWNNETSET = [{{ announced_prefixes4 | map('regex_replace', '$', '+') | join(', ') }}];
define OWNNETSETv6 = [{{ announced_prefixes6 | map('regex_replace', '$', '+') | join(', ') }}];
define OWNNETEXACTSET = [{{ announced_prefixes4 | join(', ') }}];
define OWNNETEXACTSETv6 = [{{ announced_prefixes6 | join(', ') }}];
define OWNHOSTNAME = "{{ ansible_host }}";
define DN42_REGION = {{ dn42_regions[region] }};
define DN42_COUNTRY = {{ dn42_countries[country] }};

{% for prefix in ownnet4_extra | default([]) %}
protocol static {
    route {{ prefix }} reject;

    ipv4 { import all; export none; };
}
{% endfor %}

{% for prefix in ownnet6_extra | default([]) %}
protocol static {
    route {{ prefix }} reject;

    ipv6 { import all; export none; };
}
{% endfor %}

{% if traceroute_loop_prefix is defined %}
protocol static {
    route {{ traceroute_loop_prefix }} reject;

    ipv6 { import all; export none; };
}
{% endif %}
