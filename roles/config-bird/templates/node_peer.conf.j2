{%- set peer_vars = hostvars.get(peer, {}) -%}
{%- set rr_nodes = groups.get('route_reflector', []) -%}
{%- set local_is_rr = inventory_hostname in rr_nodes -%}
{%- set peer_is_rr = peer in rr_nodes -%}
# /etc/bird/nodes/{{ node_prefix }}{{ peer | replace('-', '_') }}.conf
# Generated by Ansible

protocol bgp {{ node_prefix }}{{ peer | replace('-', '_') }} from internal_bgp {
    neighbor {{ peer_vars.ownip6 }} as OWNAS;
{% if local_is_rr and not peer_is_rr %}
    rr client;
{% endif %}
}
