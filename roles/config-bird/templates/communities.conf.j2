# /etc/bird/communities.conf
# Generated by Ansible
# DN42 BGP Communities - https://dn42.eu/howto/BGP-communities

define DN42_COMM = 64511;

# Latency Communities (1-9)
# Exponential ranges: [exp(x-1), exp(x)] ms
{% for id, range in latency_communities.items() %}
define LATENCY_{{ id }} = (DN42_COMM, {{ id }});
{% endfor %}

# Bandwidth Communities (21-29)
# Bandwidth >= 10^(x-2) mbit
{% for id, mbps in bandwidth_communities.items() %}
define BANDWIDTH_{{ id }} = (DN42_COMM, {{ id }});
{% endfor %}

# Encryption Communities (31-34)
{% for id, name in encryption_communities.items() %}
define ENCRYPTION_{{ name | upper }} = (DN42_COMM, {{ id }});
{% endfor %}

# Region Communities (41-70)
{% for name, id in dn42_regions.items() %}
define REGION_{{ name }} = (DN42_COMM, {{ id }});
{% endfor %}

# Country Communities (1000-1999)
# ISO-3166-1 numeric + 1000
{% for name, id in dn42_countries.items() %}
define COUNTRY_{{ name }} = (DN42_COMM, {{ id }});
{% endfor %}
