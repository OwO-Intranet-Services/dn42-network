(dn42_tls) {
    tls {
        ca {{ dn42_acme_directory }}
    }
}

(dn42_tls_dns01) {
    tls {
        ca {{ dn42_acme_directory }}
        dns rfc2136 {
            server {{ caddy_dns01_rfc2136_server }}
            key_name {{ caddy_dns01_tsig_key_name }}
            key_alg {{ caddy_dns01_tsig_key_algo }}
            key {{ caddy_dns01_tsig_key_value }}
        }
    }
}

{% for site in all_websites %}
# {{ site.name }}
{% if site.server_name is string %}
{{ site.server_name }} {
{% else %}
{{ site.server_name | join(', ') }} {
{% endif %}
    {% if site.dn42_cert_dns01 | default(false) %}
    import dn42_tls_dns01
    {% elif site.dn42_cert | default(false) %}
    import dn42_tls
    {% elif site.ssl_cert is defined %}
    tls {{ site.ssl_cert }} {{ site.ssl_key }}
    {% endif %}

    header Strict-Transport-Security max-age=31536000;

    {% if site.type == 'lg-proxy' %}
    reverse_proxy http://{{ site.upstream }} {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    {% elif site.type == 'lg-server' %}
    handle /api/ws {
        reverse_proxy http://{{ site.upstream }}
    }
    handle /api/* {
        reverse_proxy http://{{ site.upstream }} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle /swagger-ui/* {
        reverse_proxy http://{{ site.upstream }} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    handle /api-docs/* {
        reverse_proxy http://{{ site.upstream }} {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    {% elif site.type == 'flapalerted' %}
    reverse_proxy http://{{ site.upstream }} {
        header_up Host {http.request.host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    {% elif site.type == 'network-site' %}
    root * {{ site.root }}

    handle /visitor-info {
        header Content-Type application/json
        respond `{"node": "{{ inventory_hostname }}", "ip": "{remote_host}"}` 200
    }

    handle {
        file_server
        try_files {path} {path}/ /index.html
    }
    {% elif site.type == 'autopeer-site' %}
    root * {{ site.root }}

    handle /v1/* {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /health {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /oidc/* {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /auth/* {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /openapi.json {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /swagger {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /swagger/* {
        reverse_proxy {{ site.backend_upstream }} {
            header_up Host {{ site.backend_host }}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        file_server
        try_files {path} {path}/ /index.html
    }
    {% elif site.type == 'anycast-site' %}
    handle / {
        header Content-Type text/html
        respond `
            <html>
            <body>
                <h1>{{site.server_name}}</h1>
                <h2>{{site.listen_ipv4}} - {{site.listen_ipv6}}</h2>
                <p>{{ inventory_hostname }}</p>
            </body>
            </html>
        ` 200
    }
    {% elif site.type == 'node-health' %}
    handle /health {
        respond 200
    }
    {% if site.metrics | default(false) %}
    handle /metrics/bird {
        basicauth {
            {{ prometheus_basic_auth_user }} {{ prometheus_basic_auth_hash }}
        }
        rewrite * /metrics
        reverse_proxy http://127.0.0.1:9324
    }
    handle /metrics* {
        basicauth {
            {{ prometheus_basic_auth_user }} {{ prometheus_basic_auth_hash }}
        }
        reverse_proxy http://127.0.0.1:9100
    }
    {% endif %}
    {% elif site.type == 'static-site' %}
    root * {{ site.root | default('/var/www/html/' + site.server_name) }}
    file_server
    try_files {path} {path}/ =404
    {% endif %}
}
{% endfor %}

import /etc/caddy/conf.d/*
