{% set peer_order = peer.peer_order | int %}
{% set order = wg_node_self_order | int %}

[Interface]
PrivateKey = {{ wireguard_private_key }}
ListenPort = {{ 30000 + peer_order }}
Table = off
{% if wireguard_peer_default_mtu %}
MTU = {{ wireguard_peer_default_mtu }}
{% endif %}
PostUp = ip addr add {{ inter_node_lla_prefix }}{{ order }}/64 dev %i

[Peer]
PublicKey = {{ peer.public_key }}
Endpoint = {{ peer.endpoint_host }}:{{ 30000 + order }}
AllowedIPs = {{ (wireguard_allowed_ips + wireguard_allowed_ips_internal) | join(', ') }}
