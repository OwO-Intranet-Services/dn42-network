# Generated by Ansible
global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: node
    scheme: https
    metrics_path: /metrics
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups[node_group] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}

  - job_name: bird
    scheme: https
    metrics_path: /metrics/bird
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups[dn42_group] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}
