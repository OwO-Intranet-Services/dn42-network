# Generated by Ansible
global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: node-local
    scheme: http
    metrics_path: /metrics
    static_configs:
      - targets:
          - 127.0.0.1:9100
        labels:
          instance: fra-01

  - job_name: node
    scheme: https
    metrics_path: /metrics
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups[node_group] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}

  - job_name: bird
    scheme: https
    metrics_path: /metrics/bird
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups[dn42_group] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}

  - job_name: smokeping
    scheme: https
    metrics_path: /metrics/smokeping
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups[dn42_group] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}

  - job_name: flapalerted
    scheme: https
    metrics_path: /metrics/flapalerted
    basic_auth:
      username: {{ prometheus_basic_auth_user }}
      password: {{ prometheus_basic_auth_password }}
    static_configs:
{% for host in groups['flapalerted'] %}
      - targets:
          - {{ hostvars[host].ansible_host }}
        labels:
          instance: {{ host }}
{% endfor %}
