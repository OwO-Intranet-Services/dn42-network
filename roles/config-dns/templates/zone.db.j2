; Generated by Ansible.

$TTL {{ zone.ttl }}
$ORIGIN {{ zone.origin }}

; SOA Record
@       IN      SOA     {{ zone.soa.primary_ns }} {{ zone.soa.contact }} (
                        {{ zone.soa.serial }}      ; Serial
                        {{ zone.soa.refresh }}      ; Refresh
                        {{ zone.soa.retry }}        ; Retry
                        {{ zone.soa.expire }}       ; Expire
                        {{ zone.soa.minimum }} )    ; Negative Cache TTL

; NS Records
{% for ns in dns_nameservers %}
@       IN      NS      {{ ns }}.{{ domain_name }}.
{% endfor %}

{% if zone.records is defined %}
{%   for record in zone.records %}
{%     if record.comment is defined %}; {{ record.comment }}
{%     endif %}
{{ record.name | default('@') }}{% if record.ttl is defined %} {{ record.ttl }}{% endif %} {{ record.class | default('IN') }} {{ record.type }} {{ record.value }}
{%   endfor %}
{% endif %}

{% if zone.name == domain_name %}

; ACME dns-01 challenges
$INCLUDE {{ dns_acme_challenge_include_path }}

; Nodes (A / AAAA)
{%   for host in groups['nodes'] %}
{%     if hostvars[host].ownip is defined %}
{{ host }}.node  IN  A     {{ hostvars[host].ownip }}
{%     endif %}
{%     if hostvars[host].ownip6 is defined %}
{{ host }}.node  IN  AAAA  {{ hostvars[host].ownip6 }}
{%     endif %}
{%   endfor %}

; LG Proxy
{%   for host in groups['dn42'] %}
lg-proxy.{{ host }}.node  IN  CNAME  {{ hostvars[host].ansible_host }}.
{%   endfor %}

; Autopeer Frontend
{%   if lg_autopeer_domain is defined and lg_autopeer_domain.endswith(domain_name) %}
{{ lg_autopeer_domain | replace('.' + domain_name, '') }}  IN  A     {{ hostvars[lg_autopeer_frontend_host].ownip }}
{{ lg_autopeer_domain | replace('.' + domain_name, '') }}  IN  AAAA  {{ hostvars[lg_autopeer_frontend_host].ownip6 }}
{%   endif %}

; LG Server Domains
{%   if lg_server_domains is defined %}
{%     for domain in lg_server_domains %}
{%       if domain.endswith(domain_name) %}
{{ domain | replace('.' + domain_name, '') }}  IN  A     {{ hostvars[groups['lg_server'][0]].ownip }}
{{ domain | replace('.' + domain_name, '') }}  IN  AAAA  {{ hostvars[groups['lg_server'][0]].ownip6 }}
{%       endif %}
{%     endfor %}
{%   endif %}

; Anycast Services
{%   if dns_anycast_records is defined %}
{%     for record in dns_anycast_records %}
{%       if record.ipv4 is defined and record.ipv4 %}
{{ record.name }}    IN      A       {{ record.ipv4 }}
{%       endif %}
{%       if record.ipv6 is defined and record.ipv6 %}
{{ record.name }}    IN      AAAA    {{ record.ipv6 }}
{%       endif %}
{%     endfor %}
{%   endif %}

; CNAME Records
{%   if dns_cname_records is defined %}
{%     for record in dns_cname_records %}
{{ record.name }}    IN      CNAME   {{ record.target }}
{%     endfor %}
{%   endif %}

{% endif %}

{% if zone.name == reverse_zone_ipv4 %}
; Nameserver PTR Records
{%   for ns in dns_nameservers %}
{%     set ns_record = dns_anycast_records | selectattr('name', 'equalto', ns) | first %}
{%     if ns_record.ipv4 is defined and ns_record.ipv4 %}
{{ ns_record.ipv4.split('.')[-1] }}    IN      PTR     {{ ns }}.{{ domain_name }}.
{%     endif %}
{%   endfor %}

{%   for host in groups['nodes'] %}
{%     if hostvars[host].ownip is defined %}
{{ hostvars[host].ownip.split('.')[-1] }}  IN  PTR  {{ host }}.node.iris.dn42.
{%     endif %}
{%   endfor %}

; Anycast PTR
{%   if dns_anycast_records is defined %}
{%     for record in dns_anycast_records %}
{%       if record.ipv4 is defined and record.ipv4 %}
{{ record.ipv4.split('.')[-1] }}  IN  PTR  {{ record.name }}.{{ domain_name }}.
{%       endif %}
{%     endfor %}
{%   endif %}
{% endif %}

{% if zone.name == reverse_zone_ipv6 %}
; Nameserver PTR Records
{%   for ns in dns_nameservers %}
{%     set ns_record = dns_anycast_records | selectattr('name', 'equalto', ns) | first %}
{%     if ns_record.ipv6 is defined and ns_record.ipv6 %}
{{ (ns_record.ipv6 | ansible.utils.ipaddr('revdns')) | replace('.' + zone.origin, '') }}    IN      PTR     {{ ns }}.{{ domain_name }}.
{%     endif %}
{%   endfor %}

{%   for host in groups['nodes'] %}
{%     if hostvars[host].ownip6 is defined %}
{{ (hostvars[host].ownip6 | ansible.utils.ipaddr('revdns')) | replace('.' + zone.origin, '') }}  IN  PTR  {{ host }}.node.iris.dn42.
{%     endif %}
{%   endfor %}

; Anycast PTR
{%   if dns_anycast_records is defined %}
{%     for record in dns_anycast_records %}
{%       if record.ipv6 is defined and record.ipv6 %}
{{ (record.ipv6 | ansible.utils.ipaddr('revdns')) | replace('.' + zone.origin, '') }}  IN  PTR  {{ record.name }}.{{ domain_name }}.
{%       endif %}
{%     endfor %}
{%   endif %}
{% endif %}
